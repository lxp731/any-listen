# 交叉架构装配用 Dockerfile（不需要 QEMU 跑构建）
#
# 原理：web-server 的构建产物（build/ 下的 JS 与前端静态文件）与架构无关，
# 唯一与架构相关的是 native/<platform>_<arch>_v11/better_sqlite3.node。
# 所以可以：在宿主（x64）上构建一次 → 为每个目标架构装配镜像 + 塞入对应架构的原生库。
#
# 注意：上游发布的 native-lib（any-listen-web-server-native-lib 的 release 资产）
# 是 **glibc** 构建（NEEDED 里是 libc.so.6 / GLIBC_2.28），
# 因此这里用 Debian(glibc) 的 node 镜像作为基底，而不是 alpine(musl)。
# （官方 alpine 镜像能用是因为它在构建时于 alpine 内自己编译 musl 版 .node）
#
# 用法见 scripts/build-multiarch.sh

ARG BASE_IMAGE=docker.io/library/node:24-bookworm-slim
FROM ${BASE_IMAGE}

ARG NATIVE_ARCH=x64
ARG NATIVE_VERSION=11

WORKDIR /server

RUN groupadd -g 1001 algroup \
 && useradd -u 1001 -g algroup -M -s /sbin/nologin anylisten \
 && mkdir -p /server/data \
 && chown anylisten:algroup /server/data

# 宿主机（x64）上构建好的产物，架构无关
COPY build ./

# 丢掉宿主机那份 x64(musl) 原生库，换成目标架构的 glibc 版本
RUN rm -rf /server/native && mkdir -p /server/native/linux_${NATIVE_ARCH}_v${NATIVE_VERSION}
COPY .native-cross/linux_${NATIVE_ARCH}_v${NATIVE_VERSION}/ /server/native/linux_${NATIVE_ARCH}_v${NATIVE_VERSION}/

RUN chown -R anylisten:algroup /server

ENV DATA_PATH="/server/data"
ENV NODE_ENV="production"
ENV PORT="9500"
ENV BIND_IP="0.0.0.0"

EXPOSE 9500

USER anylisten

CMD [ "node", "index.cjs" ]
